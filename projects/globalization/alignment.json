  "sentences": [
    {
      "id": 0,
      "text": "Hãy nhìn vào chiếc điện thoại bạn đang sử dụng.",
      "start": 0,
      "end": 1.973311,
      "timing": "estimated_sentence",
      "word_count": 10
    },
    {
      "id": 1,
      "text": "Nó có thể được thiết kế tại Mỹ, sử dụng linh kiện sản xuất ở Hàn Quốc, Đài Loan, Nhật Bản, rồi được lắp ráp tại Trung Quốc hoặc Việt Nam.",
      "start": 2.440748,
      "end": 10.212177,
      "timing": "estimated_sentence",
      "word_count": 31
    },
    {
      "id": 2,
      "text": "Một sản phẩm nhỏ bé, nhưng lại là kết quả hợp tác của nhiều quốc gia trên thế giới.",
      "start": 10.871293,
      "end": 15.113016,
      "timing": "estimated_sentence",
      "word_count": 19
    },
    {
      "id": 3,
      "text": "Đó chính là một biểu hiện của toàn cầu hóa.",
      "start": 15.705714,
      "end": 17.932041,
      "timing": "estimated_sentence",
      "word_count": 10
    },
    {
      "id": 4,
      "text": "Toàn cầu hóa là quá trình các quốc gia ngày càng kết nối và phụ thuộc lẫn nhau thông qua thương mại, đầu tư, công nghệ, thông tin và văn hóa.",
      "start": 19.166757,
      "end": 27.669569,
      "timing": "estimated_sentence",
      "word_count": 31
    },
    {
      "id": 5,
      "text": "Hãy tưởng tượng thế giới là một mạng lưới khổng lồ.",
      "start": 28.445125,
      "end": 31.001497,
      "timing": "estimated_sentence",
      "word_count": 11
    },
    {
      "id": 6,
      "text": "Mỗi quốc gia là một điểm kết nối.",
      "start": 31.490181,
      "end": 33.254943,
      "timing": "estimated_sentence",
      "word_count": 8
    },
    {
      "id": 7,
      "text": "Hàng hóa, tiền bạc, con người và ý tưởng liên tục di chuyển giữa những điểm đó.",
      "start": 33.620227,
      "end": 39.040295,
      "timing": "estimated_sentence",
      "word_count": 17
    },
    {
      "id": 8,
      "text": "Nhờ toàn cầu hóa, một doanh nghiệp có thể bán sản phẩm ra khắp thế giới.",
      "start": 39.817234,
      "end": 43.62458,
      "timing": "estimated_sentence",
      "word_count": 16
    },
    {
      "id": 9,
      "text": "Người tiêu dùng có thêm lựa chọn, còn các quốc gia có cơ hội tiếp cận công nghệ, vốn đầu tư và thị trường mới.",
      "start": 44.211633,
      "end": 50.832948,
      "timing": "estimated_sentence",
      "word_count": 25
    },
    {
      "id": 10,
      "text": "Nhưng toàn cầu hóa không chỉ mang lại lợi ích.",
      "start": 51.924308,
      "end": 54.007256,
      "timing": "estimated_sentence",
      "word_count": 10
    },
    {
      "id": 11,
      "text": "Khi doanh nghiệp chuyển nhà máy sang nơi có chi phí thấp hơn, một số người lao động có thể mất việc làm.",
      "start": 54.63873,
      "end": 59.904218,
      "timing": "estimated_sentence",
      "word_count": 23
    },
    {
      "id": 12,
      "text": "Những quốc gia phụ thuộc quá nhiều vào chuỗi cung ứng nước ngoài cũng dễ bị ảnh hưởng khi xảy ra khủng hoảng.",
      "start": 60.685442,
      "end": 66.145941,
      "timing": "estimated_sentence",
      "word_count": 23
    },
    {
      "id": 13,
      "text": "Và khi một nền kinh tế lớn gặp khó khăn, tác động có thể nhanh chóng lan sang nhiều quốc gia khác.",
      "start": 66.97034,
      "end": 72.346757,
      "timing": "estimated_sentence",
      "word_count": 22
    },
    {
      "id": 14,
      "text": "Toàn cầu hóa còn làm thay đổi văn hóa.",
      "start": 73.936916,
      "end": 75.913084,
      "timing": "estimated_sentence",
      "word_count": 9
    },
    {
      "id": 15,
      "text": "Âm nhạc, phim ảnh và xu hướng từ một quốc gia có thể lan rộng khắp hành tinh chỉ trong thời gian ngắn.",
      "start": 76.527302,
      "end": 82.726848,
      "timing": "estimated_sentence",
      "word_count": 23
    },
    {
      "id": 16,
      "text": "Vậy toàn cầu hóa là tốt hay xấu?",
      "start": 83.760975,
      "end": 85.870907,
      "timing": "estimated_sentence",
      "word_count": 8
    },
    {
      "id": 17,
      "text": "Câu trả lời không đơn giản.",
      "start": 86.702313,
      "end": 87.898707,
      "timing": "estimated_sentence",
      "word_count": 6
    },
    {
      "id": 18,
      "text": "Nó tạo ra cơ hội, nhưng cũng đặt ra những thách thức về việc làm, bất bình đẳng và sự phụ thuộc.",
      "start": 88.559932,
      "end": 94.288753,
      "timing": "estimated_sentence",
      "word_count": 22
    },
    {
      "id": 19,
      "text": "Điều quan trọng không chỉ là thế giới kết nối đến mức nào, mà còn là những lợi ích và rủi ro từ sự kết nối ấy được phân chia ra sao.",
      "start": 95.155442,
      "end": 103.235918,
      "timing": "estimated_sentence",
      "word_count": 32
    }
  ],
  "limitations": "Sentence timing is approximate and user-approved for the first cut. Silence boundaries do not establish word-level recognition."
